#!/usr/bin/env python3
"""skill-lib: search, show, enable and disable on-demand skills and agents.

Library layout (never scanned by Codex or Claude Code):
  ~/.agents/skill-library/skills/<collection>/<skill>/SKILL.md
  ~/.agents/skill-library/agents/<collection>/<agent>.md
  ~/.agents/skill-library/INDEX.tsv   (generated by `skill-lib reindex`)

Commands:
  skill-lib search <words...>     rank entries whose name/description match all words
  skill-lib show <name|path>      print the entry's path and full SKILL.md / agent file
  skill-lib path <name>           print the directory (skills) or file (agents)
  skill-lib enable <name>         symlink a library skill into ~/.agents/skills (always-on)
  skill-lib disable <name>        remove that symlink again
  skill-lib list [collection]     list entries (optionally one collection)
  skill-lib reindex               rebuild INDEX.tsv and INDEX.md
"""
import os, sys, re, pathlib

LIB = pathlib.Path(os.environ.get("SKILL_LIBRARY", pathlib.Path.home() / ".agents/skill-library"))
CORE = pathlib.Path(os.environ.get("SKILL_CORE", pathlib.Path.home() / ".agents/skills"))
INDEX = LIB / "INDEX.tsv"

def frontmatter(text):
    m = re.match(r"^---\s*\n(.*?)\n---", text, re.S)
    if not m:
        return {}
    fm, out, key = m.group(1), {}, None
    for line in fm.splitlines():
        km = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if km:
            key = km.group(1); val = km.group(2).strip()
            if val in ("|", ">", "|-", ">-"):
                val = ""
            out[key] = val.strip('"').strip("'")
        elif key and line.startswith((" ", "\t")):
            out[key] = (out[key] + " " + line.strip()).strip()
    return out

def clean(s, n=300):
    s = re.sub(r"\s+", " ", s or "").strip()
    return s[:n]

def scan():
    rows = []
    sk = LIB / "skills"
    if sk.is_dir():
        for md in sorted(sk.glob("*/*/SKILL.md")):
            d = md.parent; coll = d.parent.name
            fm = frontmatter(md.read_text(errors="replace"))
            rows.append(("skill", fm.get("name") or d.name, coll, clean(fm.get("description")), str(d)))
    ag = LIB / "agents"
    if ag.is_dir():
        for md in sorted(ag.glob("*/*.md")):
            fm = frontmatter(md.read_text(errors="replace"))
            rows.append(("agent", fm.get("name") or md.stem, md.parent.name, clean(fm.get("description")), str(md)))
    return rows

def load():
    if not INDEX.exists():
        reindex(quiet=True)
    rows = []
    for line in INDEX.read_text().splitlines()[1:]:
        p = line.split("\t")
        if len(p) == 5:
            rows.append(tuple(p))
    return rows

def reindex(quiet=False):
    rows = scan()
    with open(INDEX, "w") as fh:
        fh.write("kind\tname\tcollection\tdescription\tpath\n")
        for r in rows:
            fh.write("\t".join(x.replace("\t", " ") for x in r) + "\n")
    colls = {}
    for r in rows:
        colls.setdefault((r[0], r[2]), []).append(r)
    with open(LIB / "INDEX.md", "w") as fh:
        fh.write("# Skill library index\n\nGenerated by `skill-lib reindex`. One line per entry: name - description.\n")
        for (kind, coll) in sorted(colls):
            fh.write(f"\n## {kind}s / {coll} ({len(colls[(kind, coll)])})\n\n")
            for r in colls[(kind, coll)]:
                fh.write(f"- {r[1]} - {r[3][:160]}\n")
    if not quiet:
        print(f"indexed {sum(1 for r in rows if r[0]=='skill')} skills and {sum(1 for r in rows if r[0]=='agent')} agents in {len(set(r[2] for r in rows))} collections -> {INDEX}")

def find(name):
    rows = load()
    exact = [r for r in rows if r[1] == name or pathlib.Path(r[4]).name == name or r[4] == name or f"{r[2]}/{r[1]}" == name]
    return exact

def search(words):
    words = [w.lower() for w in words]
    scored = []
    for r in load():
        hay_name = (r[1] + " " + r[2]).lower(); hay = (hay_name + " " + r[3]).lower()
        if all(w in hay for w in words):
            score = sum(3 for w in words if w in hay_name) + sum(1 for w in words if w in r[3].lower())
            scored.append((-score, r[1], r))
    for _, _, r in sorted(scored)[:40]:
        print(f"{r[0]:5} {r[2]}/{r[1]}\n      {r[3][:200]}\n      {r[4]}")
    if not scored:
        print("no match; try fewer or broader words")

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "reindex":
        reindex(); return 0
    if cmd == "search":
        search(args); return 0
    if cmd == "list":
        for r in load():
            if not args or r[2] == args[0]:
                print(f"{r[0]:5} {r[2]}/{r[1]} - {r[3][:120]}")
        return 0
    if cmd in ("show", "path", "enable", "disable"):
        if not args:
            print(f"usage: skill-lib {cmd} <name>"); return 2
        hits = find(args[0])
        if not hits:
            print(f"not found: {args[0]} (try: skill-lib search {args[0]})"); return 1
        if len(hits) > 1 and cmd != "show":
            print("ambiguous; use collection/name:"); [print(f"  {h[2]}/{h[1]}") for h in hits]; return 1
        for h in hits:
            p = pathlib.Path(h[4])
            if cmd == "path":
                print(p); continue
            if cmd == "show":
                f = p / "SKILL.md" if p.is_dir() else p
                print(f"# {h[0]} {h[2]}/{h[1]}\n# path: {p}\n")
                print(f.read_text(errors="replace"))
                if p.is_dir():
                    extra = sorted(str(x.relative_to(p)) for x in p.rglob("*") if x.is_file() and x.name != "SKILL.md")
                    if extra:
                        print("\n# bundled files (paths in SKILL.md are relative to the path above):")
                        for e in extra[:80]: print("  " + e)
                continue
            if h[0] != "skill":
                print("only skills can be enabled; agents are loaded by reading their file"); return 1
            link = CORE / p.name
            if cmd == "enable":
                if link.exists() or link.is_symlink():
                    print(f"exists already: {link} -> {os.readlink(link) if link.is_symlink() else '(real dir)'}"); return 1
                link.symlink_to(p); print(f"enabled: {link} -> {p} (new sessions will list it)")
            else:
                if link.is_symlink() and pathlib.Path(os.readlink(link)) == p:
                    link.unlink(); print(f"disabled: removed {link}")
                else:
                    print(f"not enabled from the library: {link}"); return 1
        return 0
    print(__doc__); return 2

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
