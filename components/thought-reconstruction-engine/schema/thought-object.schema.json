{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thought-reconstruction/thought-object/v1",
  "title": "ThoughtObject",
  "type": "object",
  "required": ["id", "type", "title", "reconstruction", "status", "evidence", "scores"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "type": {
      "type": "string",
      "enum": ["idea", "observation", "hypothesis", "belief", "question", "problem", "solution", "concept", "prediction", "discovery", "preference", "goal"]
    },
    "title": {"type": "string", "maxLength": 140},
    "reconstruction": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "weak", "refuted", "abandoned"]},
    "cluster": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "quote"],
        "additionalProperties": false,
        "properties": {
          "source": {"type": "string"},
          "ref": {"type": "string"},
          "quote": {"type": "string"},
          "date": {"type": "string"}
        }
      }
    },
    "evolution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "kind"],
        "additionalProperties": false,
        "properties": {
          "date": {"type": "string"},
          "kind": {"type": "string", "enum": ["originated", "refined", "contradicted", "context-dependent", "restated", "abandoned"]},
          "note": {"type": "string"}
        }
      }
    },
    "critique": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "finding"],
        "additionalProperties": false,
        "properties": {
          "date": {"type": "string"},
          "finding": {"type": "string"}
        }
      }
    },
    "scores": {
      "type": "object",
      "required": ["coherence", "evidence", "originality", "usefulness", "feasibility", "significance", "maturity", "research_confidence"],
      "additionalProperties": false,
      "properties": {
        "coherence": {"type": "integer", "minimum": 0, "maximum": 100},
        "evidence": {"type": "integer", "minimum": 0, "maximum": 100},
        "originality": {"type": "integer", "minimum": 0, "maximum": 100},
        "usefulness": {"type": "integer", "minimum": 0, "maximum": 100},
        "feasibility": {"type": "integer", "minimum": 0, "maximum": 100},
        "significance": {"type": "integer", "minimum": 0, "maximum": 100},
        "maturity": {"type": "integer", "minimum": 0, "maximum": 100},
        "research_confidence": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "outlet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suggested": {"type": "string", "enum": ["essay", "y2-draft", "adamant", "public-operator", "none"]},
        "note": {"type": "string"}
      }
    }
  }
}
